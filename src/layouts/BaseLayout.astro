---
import '@fontsource-variable/cormorant-garamond';
import '@fontsource-variable/cormorant-garamond/wght-italic.css';
import '@fontsource-variable/jost';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getImage } from 'astro:assets';
import { media, site, url } from '../lib/content';

interface Props {
  title?: string;
  description?: string;
  overlayHeader?: boolean;
  ogSlot?: string;
}

const {
  title,
  description = 'Grotta Christmas Village 2026 at Grotta Resort, Musanze — open every day from 18 December 2026 to 10 January 2027, 12:00 PM to 10:00 PM. Festive food, family experiences, cinema, swimming and the cave route.',
  overlayHeader = false,
  ogSlot = 'hero',
} = Astro.props;

const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | Grotta Resort, Musanze`;
const og = await getImage({ src: media(ogSlot).src, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const ogUrl = Astro.site ? new URL(og.src, Astro.site).href : og.src;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#0c0b09" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/png" href={url('/brand/grotta-official-logo.png')} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header overlay={overlayHeader} />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            e.target.classList.add('is-in');
            io.unobserve(e.target);
          }
        },
        { rootMargin: '0px 0px -12% 0px', threshold: 0.01 },
      );
      els.forEach((el) => io.observe(el));
    </script>
  </body>
</html>
