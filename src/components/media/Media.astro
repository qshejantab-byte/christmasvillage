---
import { Picture } from 'astro:assets';
import { media, url } from '../../lib/content';

interface Props {
  slot: string;
  sizes?: string;
  widths?: number[];
  priority?: boolean;
  ratio?: string;
  parallax?: boolean | string;
  reveal?: boolean;
  class?: string;
  caption?: string;
}

const {
  slot,
  sizes = '100vw',
  widths = [480, 768, 1080, 1440, 1920, 2560],
  priority = false,
  ratio,
  parallax = false,
  reveal = false,
  class: className,
  caption,
} = Astro.props;

const item = media(slot);
const available = widths.filter((w) => w <= item.src.width);
if (!available.length || available[available.length - 1] < item.src.width) available.push(item.src.width);
const video = item.video;
const parallaxAmount = typeof parallax === 'string' ? parallax : '7%';
const Wrapper = caption ? 'figure' : 'div';
---

<Wrapper
  class:list={['media', className, { 'has-video': !!video }]}
  style={ratio ? `aspect-ratio:${ratio}` : undefined}
  data-media={slot}
  data-reveal={reveal ? 'image' : undefined}
>
  <div class="media__inner" data-parallax={parallax ? '' : undefined} style={parallax ? `--parallax:${parallaxAmount}` : undefined}>
    <Picture
      src={item.src}
      alt={item.alt}
      widths={available}
      sizes={sizes}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      quality={72}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      decoding={priority ? 'sync' : 'async'}
      style={item.position ? `object-position:${item.position}` : undefined}
    />
    {
      video && (
        <video
          class="media__video"
          muted
          playsinline
          loop
          preload="none"
          aria-hidden="true"
          data-cine
          data-priority={priority ? 'true' : undefined}
          data-mp4={url(video.mp4)}
          data-webm={video.webm ? url(video.webm) : undefined}
          data-mobile-mp4={video.mobileMp4 ? url(video.mobileMp4) : undefined}
          data-mobile-webm={video.mobileWebm ? url(video.mobileWebm) : undefined}
          style={item.position ? `object-position:${item.position}` : undefined}
        />
      )
    }
  </div>
  {
    video && (
      <button class="media__toggle" type="button" aria-label="Pause background video" data-cine-toggle hidden>
        <span aria-hidden="true" />
      </button>
    )
  }
  {caption && <figcaption class="media__caption">{caption}</figcaption>}
</Wrapper>

<style>
  .media {
    position: relative;
    overflow: hidden;
    background: var(--basalt);
    isolation: isolate;
  }
  .media__inner {
    position: absolute;
    inset: 0;
    will-change: transform;
  }
  .media__inner :global(img),
  .media__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .media__video {
    opacity: 0;
    transition: opacity 1.2s var(--ease-out);
  }
  .media.is-playing .media__video { opacity: 1; }
  .media__toggle {
    position: absolute;
    right: var(--space-s);
    bottom: var(--space-s);
    z-index: 3;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: rgb(12 11 9 / 0.45);
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }
  .media__toggle span {
    width: 0.65rem;
    height: 0.75rem;
    border-inline: 2px solid var(--cream);
  }
  .media__toggle[aria-pressed='true'] span {
    width: 0;
    height: 0;
    border: 0;
    border-left: 0.65rem solid var(--cream);
    border-block: 0.4rem solid transparent;
    margin-left: 0.2rem;
  }
  .media__caption {
    position: absolute;
    left: var(--space-s);
    bottom: var(--space-s);
    z-index: 2;
    font-size: var(--step--2);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--cream);
    text-shadow: 0 1px 12px rgb(0 0 0 / 0.6);
  }
</style>

<script>
  import { initCinematicVideo } from '../../scripts/video';
  initCinematicVideo();
</script>
